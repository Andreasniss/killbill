{
  "//": "Shared team settings; see .claude/README.md. No \"//\" inside hooks (breaks the file).",
  "// hooks": "SessionStart: env check. PreToolUse: git-guard.py asks/denies push, reset, PR in any form.",
  "permissions": {
    "//": "ask: pushes, PRs, all GitHub MCP calls. deny: force push, hard reset.",
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "mcp__github__create_pull_request",
      "mcp__github__merge_pull_request",
      "mcp__github__push_files",
      "mcp__github__create_or_update_file",
      "mcp__github"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "mcp__github__delete_file"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/session-env.sh",
            "statusMessage": "Checking Java, Maven and DB ports",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/git-guard.py\"",
            "statusMessage": "git-guard: checking for push, reset, PR",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
